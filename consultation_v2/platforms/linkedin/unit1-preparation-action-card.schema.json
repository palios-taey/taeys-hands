{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palios.org/schemas/linkedin-unit1-preparation-action-card.schema.json",
  "title": "LinkedIn Unit 1 autonomous preparation action card",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "transaction_sha256",
    "sequence",
    "phase",
    "snapshot_revision",
    "element",
    "element_sha256",
    "method",
    "verification_operation",
    "effect_class",
    "postcondition_kind",
    "card_sha256"
  ],
  "properties": {
    "schema": {"const": "linkedin_unit1_preparation_action_card_v1"},
    "transaction_sha256": {"$ref": "#/$defs/sha256"},
    "sequence": {"type": "integer", "minimum": 1},
    "phase": {"enum": ["notifications_navigation", "notifications_continuation", "notification_candidate", "thread_scroll", "thread_open"]},
    "snapshot_revision": {"$ref": "#/$defs/sha256"},
    "element": {"type": "string", "minLength": 1},
    "element_sha256": {"$ref": "#/$defs/sha256"},
    "method": {"enum": ["activate", "scroll_into_view", "mapped_pointer_activate"]},
    "verification_operation": {"enum": ["activate", "scroll_into_view"]},
    "effect_class": {"type": "string", "minLength": 1},
    "postcondition_kind": {"type": "string", "minLength": 1},
    "card_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
