{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palios-taey.org/schemas/linkedin-unit1-private-input-v1.json",
  "title": "LinkedIn Unit 1 frozen private input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "operation",
    "cycle_id",
    "transaction_id",
    "display",
    "policy_sha256",
    "notification_stream_sha256",
    "selected_activity",
    "selected_age_seconds",
    "freshness_max_hours",
    "target_passed",
    "dedup_passed",
    "author_cooloff_passed",
    "selected_post_body_sha256",
    "thread_evidence_sha256",
    "like_authorized",
    "text",
    "text_sha256",
    "expected_author_name"
  ],
  "properties": {
    "schema": {"const": "linkedin_unit1_private_input_v1"},
    "operation": {"const": "comment_from_notifications"},
    "cycle_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "transaction_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "display": {"type": "string", "pattern": "^:[1-9][0-9]{0,2}$"},
    "policy_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "notification_stream_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "selected_activity": {"type": "string", "pattern": "^[0-9]+$"},
    "selected_age_seconds": {"type": "integer", "minimum": 0, "maximum": 259200},
    "freshness_max_hours": {"const": 72},
    "target_passed": {"const": true},
    "dedup_passed": {"const": true},
    "author_cooloff_passed": {"const": true},
    "selected_post_body_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "thread_evidence_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "like_authorized": {"type": "boolean"},
    "text": {"type": "string", "minLength": 1, "maxLength": 1800, "pattern": "^[^\\u0000]+$"},
    "text_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "expected_author_name": {"type": "string", "minLength": 1, "maxLength": 200}
  }
}
