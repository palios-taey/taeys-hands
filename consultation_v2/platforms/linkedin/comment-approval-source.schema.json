{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palios-taey.org/schemas/linkedin-comment-approval-source-v1.json",
  "title": "Owner-private LinkedIn comment approval source v1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "taey_linkedin_private_comment_approval_v1"
    },
    "operation": {
      "const": "comment"
    },
    "platform": {
      "const": "linkedin"
    },
    "display": {
      "type": "string",
      "pattern": "^:[1-9][0-9]*$"
    },
    "seat_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"
    },
    "event_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
    },
    "correlation_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,159}$"
    },
    "action_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]{1,160}$"
    },
    "selected_activity": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "selected_post_body_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source_artifact_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "like_authorized": {
      "type": "boolean"
    },
    "expected_author_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1048576
    },
    "gates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "gate": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "passed": {
            "const": true
          },
          "ev": {
            "type": "object"
          }
        },
        "required": [
          "gate",
          "passed",
          "ev"
        ]
      }
    }
  },
  "required": [
    "schema",
    "operation",
    "platform",
    "display",
    "seat_id",
    "event_id",
    "correlation_id",
    "action_id",
    "selected_activity",
    "selected_post_body_sha256",
    "source_artifact_sha256",
    "like_authorized",
    "expected_author_name",
    "text",
    "gates"
  ]
}
