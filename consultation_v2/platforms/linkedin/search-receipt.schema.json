{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palios-taey.org/schemas/linkedin-job-search-receipt-v1.json",
  "title": "LinkedIn mounted job-search immutable receipt",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "nullable_digest": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "match_counts": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "structural_candidates": {"type": "integer", "minimum": 0},
        "valid_cards": {"type": "integer", "minimum": 0},
        "duplicate_cards": {"type": "integer", "minimum": 0}
      },
      "required": ["structural_candidates", "valid_cards", "duplicate_cards"]
    }
  },
  "properties": {
    "schema": {"const": "linkedin_job_search_receipt_v1"},
    "platform": {"const": "linkedin"},
    "operation": {"const": "capture_mounted_job_search"},
    "display": {"type": "string", "pattern": "^:[0-9]{1,3}$"},
    "requester": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,63}$"},
    "turn_lineage_sha256": {"$ref": "#/$defs/digest"},
    "correlation_id_sha256": {"$ref": "#/$defs/digest"},
    "deadline_seconds": {"type": "integer", "minimum": 30, "maximum": 1700},
    "hands_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "state": {"enum": ["captured", "already_captured", "no_cards", "postcondition_failed", "technical_failure"]},
    "ok": {"type": "boolean"},
    "failure_code": {
      "oneOf": [
        {"enum": ["deadline_expired", "display_lock_unavailable", "lock_release_indeterminate", "post_observation_indeterminate", "postcondition_failed", "pre_observation_failed", "private_input_invalid", "sink_write_indeterminate"]},
        {"type": "null"}
      ]
    },
    "transaction_sha256": {"$ref": "#/$defs/nullable_digest"},
    "expected_transaction_sha256": {"$ref": "#/$defs/digest"},
    "search_ref_sha256": {"$ref": "#/$defs/nullable_digest"},
    "sink_ref_sha256": {"$ref": "#/$defs/nullable_digest"},
    "pre_observation_sha256": {"$ref": "#/$defs/nullable_digest"},
    "pre_match_counts": {"$ref": "#/$defs/match_counts"},
    "stable_cycles_observed": {"type": "integer", "minimum": 0},
    "lock": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "policy": {"const": "careers"},
        "request_id": {"$ref": "#/$defs/digest"},
        "acquired": {"type": "boolean"},
        "released": {"type": "boolean"},
        "owner_token_sha256": {"$ref": "#/$defs/nullable_digest"},
        "wait_ms": {"type": "integer", "minimum": 0},
        "turn_lineage_sha256": {"$ref": "#/$defs/digest"},
        "correlation_id_sha256": {"$ref": "#/$defs/digest"},
        "deadline_seconds": {"type": "integer", "minimum": 30, "maximum": 1700}
      },
      "required": ["policy", "request_id", "acquired", "released", "owner_token_sha256", "wait_ms", "turn_lineage_sha256", "correlation_id_sha256", "deadline_seconds"]
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {"const": "private_sink_write_once"},
        "verdict": {"enum": ["not_executed", "written", "already_present", "indeterminate"]},
        "batches_observed": {"type": "integer", "minimum": 0, "maximum": 1},
        "batches_written": {"oneOf": [{"type": "integer", "minimum": 0, "maximum": 1}, {"type": "null"}]},
        "cards_observed": {"type": "integer", "minimum": 0},
        "content_digest": {"$ref": "#/$defs/nullable_digest"}
      },
      "required": ["kind", "verdict", "batches_observed", "batches_written", "cards_observed", "content_digest"]
    },
    "postcondition": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {"const": "mounted_job_card_set_digest_unchanged"},
        "verdict": {"enum": ["not_evaluated", "satisfied", "failed", "indeterminate"]},
        "post_observation_sha256": {"$ref": "#/$defs/nullable_digest"},
        "post_match_counts": {"oneOf": [{"$ref": "#/$defs/match_counts"}, {"type": "null"}]}
      },
      "required": ["kind", "verdict", "post_observation_sha256", "post_match_counts"]
    }
  },
  "required": ["schema", "platform", "operation", "display", "requester", "turn_lineage_sha256", "correlation_id_sha256", "deadline_seconds", "hands_commit", "state", "ok", "failure_code", "transaction_sha256", "expected_transaction_sha256", "search_ref_sha256", "sink_ref_sha256", "pre_observation_sha256", "pre_match_counts", "stable_cycles_observed", "lock", "action", "postcondition"]
}
