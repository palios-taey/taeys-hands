{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://palios-taey.org/schemas/linkedin-jobs-private-input-v1.json",
  "title": "LinkedIn Jobs private runtime input",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema": {
      "const": "linkedin_jobs_private_input_v1"
    },
    "operation": {
      "enum": [
        "capture_selected_job",
        "capture_visible_new_engagement_signal",
        "select_and_capture_job"
      ]
    },
    "search_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "sink_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "target_card_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "detail_title_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "detail_company_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "source_ref": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "return_url": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    }
  },
  "required": [
    "schema",
    "operation",
    "sink_ref"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "operation": {
            "const": "select_and_capture_job"
          }
        }
      },
      "then": {
        "required": [
          "target_card_name",
          "detail_title_name",
          "detail_company_name"
        ]
      },
      "else": {
        "not": {
          "anyOf": [
            {"required": ["target_card_name"]},
            {"required": ["detail_title_name"]},
            {"required": ["detail_company_name"]}
          ]
        }
      }
    },
    {
      "if": {
        "properties": {
          "operation": {
            "const": "capture_visible_new_engagement_signal"
          }
        }
      },
      "then": {
        "required": [
          "source_ref",
          "return_url"
        ],
        "not": {
          "required": [
            "search_ref"
          ]
        }
      },
      "else": {
        "required": [
          "search_ref"
        ],
        "not": {
          "anyOf": [
            {
              "required": [
                "source_ref"
              ]
            },
            {
              "required": [
                "return_url"
              ]
            }
          ]
        }
      }
    }
  ]
}
